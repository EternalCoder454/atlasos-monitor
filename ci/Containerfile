# The CI dev image, ghcr.io/eternalcoder454/telamon-monitor-dev (public): Fedora
# 44 with everything CI installs, so its jobs skip dnf. telamon-ui is not in
# it: each run installs the atlas-framework release Cargo.toml pins
# (packaging/install-builddeps.sh), and installs with dnf whatever this image
# lacks. CI's image job rebuilds it weekly and when this file or the spec
# changes. Nothing secret goes in: no build arguments, no secrets.
FROM registry.fedoraproject.org/fedora:44
LABEL org.opencontainers.image.source=https://github.com/EternalCoder454/atlasos-monitor
LABEL org.opencontainers.image.description="Telamon Monitor CI build environment"
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
COPY telamon-monitor.spec /tmp/telamon-monitor.spec
# Then the spec's BuildRequires but telamon-ui; telamon-ui's own dependencies
# (Kirigami, Qt Quick, the fonts) so that installing it needs no dnf.
RUN dnf -y install git-core tar zstd gzip rpm-build dnf5-plugins cargo clippy rustfmt \
        dbus-daemon kf6-kirigami kf6-kconfig qt6-qtdeclarative ibm-plex-sans-fonts jetbrains-mono-fonts \
    && rpmspec -q --buildrequires /tmp/telamon-monitor.spec | grep -v '^telamon-ui[[:space:]]' | \
        xargs -r -d '\n' dnf -y install \
    && dnf clean all \
    && rm -f /tmp/telamon-monitor.spec
